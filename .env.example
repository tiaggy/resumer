# Copy this file to .env and fill in your values.
# .env is git-ignored.

# OpenAI-compatible endpoint. Examples:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   https://api.deepseek.com
#   https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# API key for the endpoint above.
OPENAI_API_KEY=sk-your-key-here

# Exact model identifier the endpoint accepts.
# Examples: gpt-4o, gpt-4o-mini, deepseek-chat, anthropic/claude-opus-4
OPENAI_MODEL=gpt-4o-mini

# Optional: extra header value some gateways require
# (OpenRouter recommends HTTP-Referer and X-Title; leave blank if not needed)
APP_REFERER=
APP_TITLE=Resumer

# Optional: override the local server port (default 17321).
PORT=17321
